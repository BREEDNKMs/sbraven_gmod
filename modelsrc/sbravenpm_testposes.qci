$sequence "m_raven_run_l2" { 
	"a_walking_walk_cautious_S"  // "a_canterS" 
	"a_walking_walk_cautious_E"  // "a_canterSE" 
	"a_walking_walk_cautious_E"  // "a_canterE"

	"a_M_Raven_Run_L"  // "a_canterNE" 
	"a_M_Raven_Run_L"  // "a_canterN" 
	"a_M_Raven_Run_L"  // "a_canterNW" 

	"a_walking_walk_cautious_W"  // "a_canterW" 
	"a_walking_walk_cautious_W"  // "a_canterSW" 
	"a_walking_walk_cautious_S"  // "a_canterS" 
	
	blend "move_yaw" -180 180
	blendwidth 9
	fps 30 
	activity ACT_WALK_AGITATED 32768 
	addlayer inverse_proportions 
	node "walking" 
	fudgeloop 
} 

$sequence "laughtest" "sbravenpm_anims\m_raven_slashchaincombo.smd" { 
	fps 1 
	activity ACT_DO_NOT_DISTURB 1 
	addlayer inverse_proportions
	
	origin 0 0 42 
	frames 73 74 
} 

$sequence "laughtest2" "sbravenpm_anims\MV_Nest_Intro_raven_C.smd" { 
	fps 1 
	activity ACT_DO_NOT_DISTURB 1 
	addlayer inverse_proportions
	
	origin 0 0 42 
	frames 623 624 
} 

$sequence "laughtest3" "M_Raven_SlashChainCombo_Retarget.smd" { 
	fps 1 
	activity ACT_DO_NOT_DISTURB 1 
	addlayer inverse_proportions
	
	origin 0 0 0 
} 

$sequence "raven_base" "sbravenpm_anims\raven_base.smd" { 
	fps 1 
	activity ACT_DO_NOT_DISTURB 1 
	addlayer inverse_proportions
	
	origin 0 0 42 
} 