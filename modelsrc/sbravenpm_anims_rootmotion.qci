$sequence "walk_cautious" {
	"a_walking_walk_cautious_S"  // row 1 col 1 (SW slot → backward)
	"a_walking_walk_cautious_S"  // row 1 col 2 (S slot)
	"a_walking_walk_cautious_S"  // row 1 col 3 (SE slot)

	"a_walking_walk_cautious_W"  // row 2 col 1 (W slot)
	"a_walking_walk_cautious_C"  // row 2 col 2 (Center still)
	"a_walking_walk_cautious_E"  // row 2 col 3 (E slot)

	"a_walking_walk_cautious_N"  // row 3 col 1 (NW slot)
	"a_walking_walk_cautious_N"  // row 3 col 2 (N slot → forward)
	"a_walking_walk_cautious_N"  // row 3 col 3 (NE slot)
	
	activity "ACT_MP_WALK_MELEE" 1
	blend "move_y" 1 -1
	blend "move_x" -1 1
	blendwidth 3
	fadein 0.3
	fadeout 0.3
	addlayer inverse_proportions
	LX 
	node "walking" 
	fudgeloop 
	{ event AE_NPC_LEFTFOOT 10 "" }
	{ event AE_NPC_RIGHTFOOT 28 "" }
} 

$sequence "M_Raven_Caution_FwRw" "sbravenpm_anims\M_Raven_Caution_FwRw.smd" { 
	fps 30 
	activity ACT_DO_NOT_DISTURB 1 
	addlayer inverse_proportions
	origin 0 0 42 
	LX LY 
	fudgeloop 
} 
$sequence "m_raven_run_l" { 
	"a_walking_walk_cautious_S"  // "a_canterS" 
	"a_walking_walk_cautious_E"  // "a_canterSE" 
	"a_walking_walk_cautious_E"  // "a_canterE"

	"a_M_Raven_Run_L"  // "a_canterNE" 
	"a_M_Raven_Run_L"  // "a_canterN" 
	"a_M_Raven_Run_L"  // "a_canterNW" 

	"a_walking_walk_cautious_W"  // "a_canterW" 
	"a_walking_walk_cautious_W"  // "a_canterSW" 
	"a_walking_walk_cautious_S"  // "a_canterS" 
	
	blend "move_yaw" -180 180
	blendwidth 9
	fps 30 
	activity ACT_WALK_STIMULATED 9999 
	addlayer inverse_proportions
	node "walking" 
	fudgeloop 
	{ event AE_NPC_LEFTFOOT 10 "" }
	{ event AE_NPC_RIGHTFOOT 28 "" }
} 