$Weightlist PelvisOnly { "ValveBiped.Bip01_Pelvis" 1.0
	"ValveBiped.Bip01_L_Thigh" 0.0
	"ValveBiped.Bip01_R_Thigh" 0.0
	"ValveBiped.Bip01_Spine" 0.0
	}
$Weightlist MeleeShove {
	"ValveBiped.Bip01_Pelvis" 0.0
	"ValveBiped.Bip01_L_Thigh" 0.0
	"ValveBiped.Bip01_R_Thigh" 0.0
	"ValveBiped.Bip01_Spine" 1.0
	"ValveBiped.Bip01_R_Hand" 1.0
	"ValveBiped.Bip01_R_Finger0" 0.0
	"ValveBiped.Bip01_R_Finger1" 0.0
	"ValveBiped.Bip01_R_Finger2" 0.0
	"ValveBiped.Bip01_R_Finger3" 0.0
	"ValveBiped.Bip01_R_Finger4" 0.0
	"ValveBiped.Bip01_L_UpperArm" 0.0
	}

//$animation "a_proportions_corrective_animation3" "eve_anims\a_proportions_corrective_animation.smd" 
$definemacro MakeSplineGestureLockFeet splinename filename pelvisweights baseweights peak tail end \\
$sequence $splinename$_original					$filename$ hidden \\
$animation a_$splinename$_pelvis_layer 			$filename$ subtract $splinename$_original 0 \\
//$animation b_$splinename$_inverse_proportions 			$filename$ subtract a_proportions_corrective_animation3 0 \\
$sequence $splinename$_pelvis_layer 			a_$splinename$_pelvis_layer delta weightlist $pelvisweights$ fadeout 0.1 hidden \\
//$sequence $splinename$_inverse_proportions 			a_inverse_proportions predelta weightlist $baseweights$ fadeout 0.1 hidden \\
$sequence $splinename$_base_layer 				$filename$ weightlist $baseweights$ fadeout 0.1 hidden \\
$sequence $splinename$ "sbravenpm_anims/reference" noanimation iklock rfoot 1 0 iklock lfoot 1 0 blendlayer $splinename$_pelvis_layer 0 $peak$ $tail$ $end$ spline blendlayer $splinename$_base_layer 0 $peak$ $tail$ $end$ spline numframes $end$ blendlayer inverse_proportions 0 $peak$ $tail$ $end$ spline ikrule lhand release range 0 $peak$ $tail$ $end$ ikrule rhand release range 0 $peak$ $tail$ $end$ \\
$continue $splinename$

$MakeSplineGestureLockFeet layer_LightAttack_v1_01_05 "eve_anims\LightAttack_v1_01_05.smd" PelvisOnly MeleeShove 5 37 68 ACT_GESTURE_MELEE_ATTACK1 1 fps 35 {event AE_SV_PLAYSOUND 	44.0	 "M_Raven_SwordSwish_S_Cue" }	{event AE_SV_PLAYSOUND 	10.0	 "M_Raven_vo_ATK_L_Cue" }	{event AE_SV_PLAYSOUND 	1.0	 "M_Raven_Cloth_XL_Cue" }	{event AE_SV_PLAYSOUND 	10.0	 "M_Raven_SwordSwish_XL_Cue"} { event 3001 16 "35" } 	{ event 3 16 "35" } 

