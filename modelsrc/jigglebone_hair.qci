
$definemacro HAIR_ROOT BoneName BoneLength \\
$jigglebone $BoneName$ { \\
    is_flexible { \\
        length $BoneLength$ \\
        tip_mass 2 \\
        pitch_stiffness 400 \\
        pitch_damping 14 \\
        yaw_stiffness 400 \\
        yaw_damping 14 \\
        along_stiffness 400 \\
        along_damping 60 \\
        angle_constraint 10 \\
        yaw_constraint -20 20 \\
        pitch_constraint -8 12 \\
    } \\
    has_base_spring { \\
        base_mass 5 \\
        stiffness 900 \\
        damping 40 \\
        left_constraint -0.5 0.5 \\
        up_constraint -0.5 0.5 \\
        forward_constraint -0.5 0.5 \\
        left_friction 20 \\
        up_friction 20 \\
        forward_friction 20 \\
    } \\
} \\

$definemacro HAIR_MID BoneName BoneLength \\
$jigglebone $BoneName$ { \\
    is_flexible { \\
        length $BoneLength$ \\
        tip_mass 4 \\
        pitch_stiffness 160 \\
        pitch_damping 10 \\
        yaw_stiffness 160 \\
        yaw_damping 10 \\
        along_stiffness 250 \\
        along_damping 45 \\
        angle_constraint 18 \\
        yaw_constraint -25 25 \\
        pitch_constraint -12 22 \\
    } \\
    has_base_spring { \\
        base_mass 10 \\
        stiffness 700 \\
        damping 30 \\
        left_constraint -1 1 \\
        up_constraint -1 1 \\
        forward_constraint -1 1 \\
        left_friction 12 \\
        up_friction 12 \\
        forward_friction 12 \\
    } \\
} \\

$definemacro HAIR_TIP BoneName BoneLength \\
$jigglebone $BoneName$ { \\
    is_flexible { \\
        length $BoneLength$ \\
        tip_mass 8 \\
        pitch_stiffness 60 \\
        pitch_damping 8 \\
        yaw_stiffness 60 \\
        yaw_damping 8 \\
        along_stiffness 80 \\
        along_damping 20 \\
        angle_constraint 30 \\
        yaw_constraint -45 45 \\
        pitch_constraint -25 35 \\
    } \\
    has_base_spring { \\
        base_mass 20 \\
        stiffness 400 \\
        damping 25 \\
        left_constraint -2 2 \\
        up_constraint -2 2 \\
        forward_constraint -2 2 \\
        left_friction 8 \\
        up_friction 8 \\
        forward_friction 8 \\
    } \\
} \\

