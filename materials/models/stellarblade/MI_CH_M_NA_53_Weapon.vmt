"VertexLitGeneric"
{
    // Base textures
    "$basetexture" "models/stellarblade/ch_m_na_53_weapon_a"
    "$bumpmap"     "models/stellarblade/ch_m_na_53_weapon_n"    // RGB = normal, A = envmask/metal mask

    // Model flag
    "$model" 1

    // EmissiveBlend (use this instead of $selfillum because we have $bumpmap)
    "$emissiveblendenabled"    "1"
    "$emissiveblendstrength"   "1.0"                              // start at 3.0, tweak in-game 0.5–6.0
    "$emissiveblendtexture"    "vgui/white"                       // required placeholder
    "$emissiveblendbasetexture" "models/stellarblade/ch_m_na_53_weapon_e" // emissive pattern
    "$emissiveblendflowtexture" "vgui/white"                       // static, no flow
    "$emissiveblendscrollvector" "[ 0 0 ]"
    "$emissiveblendtint" "[ 0 158.3289 300 ]"
                                                                       // => normalized; overall strength handled by strength param

    // Phong / clear-coat approximation
    "$phong"                   "1"
	"$phongexponenttexture" "models/stellarblade/CH_M_NA_53_Weapon_phongexp"
    "$phongboost"              "2.5"                              // safe default; 2–3 for balanced highlight
    "$phongexponent"           "30"                               // fallback if exponent texture missing
    "$phongalbedotint"         "1"
    "$phongfresnelranges"      "[ 0.1 0.8 1.0 ]"                   // gives stronger grazing glints
    "$phongtint"               "[ 1 1 1 ]"                        // white specular for metals; tint if needed

    // Use normal map alpha as envmap mask (reflectivity / metallic mask)
    "$normalmapalphaenvmapmask" "1"

    // Environment reflections (combined with phong)
    "$envmap"                  "env_cubemap"
    "$envmaptint"              "[ 0.07 0.12 0.15 ]"               // dark tint to avoid blowout; tweak per-metal color
    "$envmapcontrast"          "1.0"
    "$envmapfresnel"           "1"

    // Misc
    "$halflambert"             "1"    // soften dark shading
    "$nocull"                  "0"
}
