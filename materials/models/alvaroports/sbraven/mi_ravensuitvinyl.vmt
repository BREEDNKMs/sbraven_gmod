"VertexLitGeneric"
{
	"$additive"	"1" 
	"$basetexture" "models\alvaroports\SBRaven\MI_CH_NPC_Raven_01_Suit02"
	"$bumpmap" "models\alvaroports\SBRaven\MI_CH_NPC_Raven_01_Suit02_normal"
		
	//$Emissiveblend is another alternative if $selfillum and $detail can not be used.
	// Emissive (DO NOT TOUCH semantics; tint set to EmissiveColor x EmissivePower)
    "$EmissiveBlendEnabled"       "1"
    "$EmissiveBlendStrength"      "1"
    "$EmissiveBlendTexture"       "vgui/white"
    "$EmissiveBlendBaseTexture"   "models/stellarblade/MI_CH_NPC_Raven_01_Suit02_E"
    "$EmissiveBlendFlowTexture"   "vgui/white"
    "$EmissiveBlendTint"          "[ 0 13.133521 85.843895 ]"   
    "$EmissiveBlendScrollVector"  "[ 0 0 ]"

    // model-related flags
    "$model" "1"
    "$nocull" "1"              // TwoSided = true in UE -> no culling
    "$halflambert" "1"
    "$surfaceprop" "metal"
	
	// Alpha/Mask (UE Masked Blend -> alpha test)
    "$alphatest" "1"
    "$alphareference" "0.3333"   

    // Detail (optional - additive, safer with bumpmap)
    "$detail" "models/stellarblade/hexapattern_a" 
    "$detailscale" "100"
    "$detailblendmode" "0"
    "$detailblendfactor" "0.523809"  // 1 - abs(Detail Strength (-0.476191)) -> reduces detail strength

    // Environment reflections & spec masking via normal alpha
	"$envmap" "env_cubemap"
	"$normalmapalphaenvmapmask" "1"   // read spec mask from normal alpha (pre-packed)
	"$envmaptint" "[0.08 0.12 0.12]"
	"$envmapcontrast" "1"
	"$envmapsaturation" "0.95"

    // Phong (simulates clear coat): use scalars rather than texture to avoid conflicts
	"$phong" "1"
	"$phongexponent" "45"
	"$phongboost" "12"
	"$phongfresnelranges" "[0.05 0.45 1]"
	"$phongtint" "[1 1 1]"

	// Rimlight (extra grazing highlight)
	"$rimlight" "1"
	"$rimlightexponent" "12"
	"$rimlightboost" "0.6"
	"$rimmask" "1"       
	"$nowritez" "1" 
}