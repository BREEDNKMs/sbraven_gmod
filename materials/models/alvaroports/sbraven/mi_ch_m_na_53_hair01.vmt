"VertexLitGeneric"
{
    // --- Base textures (replace paths if you used different filenames) ---
    // Albedo (RGB) with hair alpha in A
    "$basetexture" "models/alvaroports/sbraven/CH_M_NA_53_HR_ADIR"
    // Normal map (RGB), ALPHA = spec/gloss mask (packed by the script)
    "$bumpmap"     "models/alvaroports/sbraven/CH_M_NA_53_Hair01_N"
	// "$color2"	" [0.15 0.15 0.15] " 
	"$phong" 1
    "$phongboost" 1.2
    "$phongfresnelranges" "[0.1 0.1 0.8]"
    "$phongexponent" 90.0
    "$halflambert" 1
    "$envmap" "env_cubemap"
    "$envmaptint" "[0.04 0.04 0.04]"
    "$alpha" "1"
    "$translucent" 0
}
