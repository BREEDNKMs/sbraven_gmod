"VertexLitGeneric"
{
	"$basetexture" "models\alvaroports\SBRaven\MI_CH_NPC_Raven_01_Suit02"
	"$bumpmap" "models\alvaroports\SBRaven\MI_CH_NPC_Raven_01_Suit02_normal"
		
	//$Emissiveblend is another alternative if $selfillum and $detail can not be used.
	// Emissive (DO NOT TOUCH semantics; tint set to EmissiveColor x EmissivePower)
    "$EmissiveBlendEnabled"       "1"
    "$EmissiveBlendStrength"      "1"
    "$EmissiveBlendTexture"       "vgui/white"
    "$EmissiveBlendBaseTexture"   "models/stellarblade/MI_CH_NPC_Raven_01_Suit02_E"
    "$EmissiveBlendFlowTexture"   "vgui/white"
    "$EmissiveBlendTint"          "[ 1.07422 8.51368 9.375 ]"   // EmissiveColor * 20 (EmissivePower)
    "$EmissiveBlendScrollVector"  "[ 0 0 ]"

    // model-related flags
    "$model" "1"
    "$nocull" "1"              // TwoSided = true in UE -> no culling
    "$halflambert" "1"
    "$surfaceprop" "metal"
	
	// Alpha/Mask (UE Masked Blend -> alpha test)
    "$alphatest" "1"
    "$alphareference" "0.3"   

    // Detail (optional - additive, safer with bumpmap)
    "$detail" "models/stellarblade/t_paintscratches" 
    "$detailscale" "8"
    "$detailblendmode" "0"
    "$detailblendfactor" "0.2"

    // Environment reflections & spec masking via normal alpha
    "$envmap" "env_cubemap"
    "$normalmapalphaenvmapmask" "1"   // use normal alpha as env/spec mask (pre-packed by script)
    "$envmaptint" "[0.08 0.12 0.12]"  // cool, slightly bluish reflection tint (tweak)
    "$envmapcontrast" "1"
    "$envmapsaturation" "0.95"

    // Phong (simulates clear coat): use scalars rather than texture to avoid conflicts
    "$phong" "1"
    "$phongexponent" "45"             // higher = sharper highlight = low UE roughness
	// map ClearCoatColorBrighness => multiply phongboost
    // base_boost ~ 8 -> final = 8 * (1 + ClearCoatColorBrighness(0.5)) = 12
    "$phongboost" "12"                // stronger boost for glossy clearcoat look
    "$phongfresnelranges" "[0.05 0.45 1]" // Fresnel-like control: push more spec at grazing angles
    "$phongtint" "[1 1 1]"            // white spec highlights (change if you want tinted metal)

    // Rimlight (additional grazing highlight)
    "$rimlight" "1"
    "$rimlightexponent" "12"
    "$rimlightboost" "0.6"
    "$rimmask" "1"                    

}