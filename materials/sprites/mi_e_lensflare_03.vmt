"UnlitGeneric"
{
    "$basetexture" "sprites/chromaCross"
    "$additive" "1"
    "$ignorez" "0"
    "$translucent" "1"
    "$vertexalpha" "1"
    "$vertexcolor" "1"
    "$nocull" "1"

    // HDR emissive boost — crisp center flash
    "$hdrbasetextureboost" "2.5"
    "$selfillum" "1"
    "$selfillumtint" "[1.0 1.0 1.0]"
    "$color" "[1.1 1.05 1.0]"      // subtle warmth

    // Fresnel edge brightening for optical flare feel
    "$selfillumfresnel" "1"
    "$selfillumfresnelminmaxexp" "[0.0 1.0 3.0]"

    // Additive cube mask for edge shaping
    "$detail" "sprites/T_A_CubeMask_01"
    "$detailscale" "1.0"
    "$detailblendmode" "0"
    "$detailblendfactor" "0.8"

    // Slight softedge falloff (approx edge saturation control)
    "$softedges" "1"
    "$edgesoftnessstart" "0.3"
    "$edgesoftnessend" "1.0"
}
