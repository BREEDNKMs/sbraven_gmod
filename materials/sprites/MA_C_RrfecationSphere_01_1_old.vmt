"Aftershock"
{
	// Base texture / mask for the band (uses your gradient)
	"$model" "1" 

	// Normal / bump driving the refraction (DX9-style bumpmap)
	"$normalmap"               "sprites/T_A_Gradient_Vertical_03"
	"$bumpframe"               "0"

	// Transform applied to the bumpmap (UV transform placeholder)
	// Format/interpretation of this string can vary between engines; adjust to your build.
	"$bumptransform"           "center 0.5 0.5 scale 1 1 rotate 0 translate 0 0"

	// Refraction strength: multiplies normal intensity
	"$refractamount"           "0.035"

	// Color tint applied to the refracted image
	"$colortint"               "[1.0 1.3 1.6]"

	// Blur level: 0, 1 or 2 (some builds accept other values; 2 = strongest)
	"$BlurAmount"              "0.1"

	// Ground fade interval (per-vertex fade depending on distance to ground)
	"$GroundMin"               "0"
	"$GroundMax"               "0"

	// Silhouette fade: color and thickness (edge fade)
	"$SilhouetteColor"         "[0.30 0.30 0.50]"
	"$SilhouetteThickness"     "0.20"

	// Allow particle / vertex modulation (useful for Niagara/particles or model vertex colors)
	"$vertexcolor"             "1"
	"$vertexalpha"             "1"

	// Two-sided, additive, alpha-test mapping to Unreal's settings
	"$nocull"                  "1"
	"$additive"                "1"
	"$alphatest"               "1"
	"$alphatestreference"      "0.3333"
	"$alpha" "10"
		// helper constants
	"$one"           "1"
	"$baseRefract"   "0.035"
	"$baseBlur"      "0.035"
	"$groundScale"   "10"
	"$_normSpeed" "1" 
	"$EntitySpeed" "1" 
}
