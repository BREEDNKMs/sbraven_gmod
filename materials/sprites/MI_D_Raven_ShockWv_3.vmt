"VertexLitGeneric"
{
	// --- Core Setup & Transformations ---
	"$basetexture" "vgui/black"
	"$bumpmap" "dev/water_normal" 
	"$color"	"[1 1 1]" 
	"$color2"	"[1 1 1]" 

	// --- Render States ---
	"$additive" 1
	"$nocull" 1

	// --- High-Frequency Detail Noise (Unlit Additive) ---
	"$detail" "sprites/T_C_NoiseTile_01"
	"$detailblendmode" "8"
	"$detailscale" "[3 0.5]"
	"$detailblendfactor" 1.0

	// --- Dynamic Scrolling Noise (Emissive Pipeline) ---
	"$emissiveblendenabled" "1"
	"$emissiveblendbasetexture" "sprites/T_A_SphereMask_01" // T_A_SphereMask_01 
	"$emissiveblendtexture" "sprites/T_C_NoiseTile_01" // T_C_NoiseTile_01
	"$emissiveblendflowtexture" "sprites/T_A_NoiseRGB_01" // T_A_RampNoise_06
	"$emissiveblendscrollvector" "[0.25 -0.5]"
	
	// Intensity multiplier matching UvNoiseIntesity_01
	"$emissiveblendtint" "[2 2 2]"
	"$emissiveblendstrength" "1"
	"$vertexcolor" "1" 
	"$vertexalpha" "1" 
}