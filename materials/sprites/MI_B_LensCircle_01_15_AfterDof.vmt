"UnlitGeneric"
{
    // Core additive lens flare setup
    "$additive" "1"
    "$translucent" "1"
    "$nowritez" "0"                
    "$vertexcolor" "0"            // allow per-particle color modulation
    "$vertexalpha" "0"            // allow per-particle alpha fade

    // Base chroma cross texture
    "$basetexture" "sprites/chromaCross"

    // Edge hardness (sharp falloff)
    "$softedges" "1"
    "$softedgestart" "0.95"
    "$softedgeend" "1.0"

}
