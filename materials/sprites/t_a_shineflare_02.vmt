"UnlitGeneric"
{
	"$basetexture" "sprites/t_a_shineflare_02"
	"$additive" "1"
	"$translucent" "1"
	"$vertexcolor" "1"
	"$vertexalpha" "1"
	"$nocull" "1"
//	"$ignorez" "1"

	// Makes it emit light even in darkness
	"$selfillum" "1"
	"$selfillumtint" "[1 1 1]"

	// Slight soft edge and gradient control
	"$softedges" "1"
	"$edgesoftnessstart" "0.2"
	"$edgesoftnessend" "0.8"

	// Optional scroll/flicker overlay (noise mod)
//	"$detail" "sprites/t_a_basenoise_04"
//	"$detailscale" "1"
//	"$detailblendmode" "2" // additive
//	"$detailblendfactor" "0.25"
}
