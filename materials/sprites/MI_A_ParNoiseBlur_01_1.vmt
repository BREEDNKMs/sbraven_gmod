"Refract"
{
    // Base Texture (used as distortion/noise)
    "$normalmap" "sprites/T_A_NoiseRGB_01"
	"$vertexcolor" "1" 
	"$vertexalpha" "1" 

    // Blur / Distortion Strength (BaseNoiseStrength ≈ 0.05)
    "$refractamount" "0.05"

    // Noise tiling and movement
    "$scrollrate" "0.07"          // (Length = 0.1, NoiseTile = 0.7, PannY = 0.0)
    "$scrollangle" "90"           // Scroll along Y (since PannY present)

    // Translucency / Additive flags
    "$translucent" "0"
    "$additive" "0"
    "$nocull" "1"                 // TwoSided = true

    // Rendering order (simulate RenderAfterDOF)
    "$decal" "1"

    // Color / Blur tint (assumed mild bluish tone)
    "$selfillumtint" "[0.5 0.6 1.0]"
    "$color" "[0.5 0.6 1.0]"

    // Optional: Fade noise alpha based on scene or camera distance (imitates dynamic blur control)
    "$bluramount" "0.5"

    // Optional: soft edge (OpacityMaskClipValue 0.3333 equivalent)
    "$softedges" "1"
    "$edgealpha" "0.333"

    // Optional fallback for low-end platforms
    "%keywords" "FX Blur Noise Refract"
}
