"UnlitGeneric"
{
	// -----------------------------------------------------------
    // 1. BASE LIGHTING (KILL IT)
    // Since the UE4 material is "Unlit", we make the base mesh 
    // pitch black. Only the additive emissive blend will show.
    // -----------------------------------------------------------
    //"$basetexture" "vgui/black"
    "$basetexture" "sprites/T_B_StreakNoise_02"
	"$additive"	"1" 
	"$bumpmap" "sprites/T_A_SwirlNoise_03_N"
	"$color"	"[5 5 5]" 

    // Detail (UvNoiseTex) used as an overlay / flow contribution
    "$detail" "sprites/T_A_NoiseTurbulence_02"
    // UvNoise_TileX / UvNoise_TileY -> detailscale [U V]
    "$detailscale" "[1.0 0.7]"
    // UvNoiseIntensity -> emulate via detail blend factor (small)
    "$detailblendfactor" "0.08"
    // detail blend mode: 1 = additive (works nicely for noise overlay)
    "$detailblendmode" "1"

    // Use vertex color/alpha so the ribbon's per-vertex color from Niagara is respected
    "$vertexcolor" "1"
    "$vertexalpha" "1"

    // -----------------------------------------------------------
    // 2. EMISSIVE BLEND (THE MAGIC LAYER)
    // -----------------------------------------------------------
    "$emissiveblendenabled"      "1"
    
    // Overall Opacity/Intensity (UE4: RibbonIntensity = 0.5)
    "$emissiveblendstrength"     "1" 
    
    // Color Tint (UE4: HighlightColor = 1,1,1)
    // We will hook into this with Lua later if we want it dynamic.
    "$emissiveblendtint"         "[5 5 5]"

    // -----------------------------------------------------------
    // 3. TEXTURE MAPPING
    // -----------------------------------------------------------
    // Main Ribbon Streak (UE4: RibbonTex -> T_B_StreakNoise_02)
    "$emissiveblendtexture"      "sprites/T_B_StreakNoise_02"

    // Mask / Fade (UE4: MaskTex -> T_A_Gradient_Vertical_02)
    // CRITICAL: Must be saved as DXT1 or i8 format (NO Alpha Channel!)
    "$emissiveblendbasetexture"  "sprites/T_A_Gradient_Vertical_02"

    // UV Distortion (UE4: UvNoiseTex -> T_A_NoiseTurbulence_02)
    // CRITICAL: Must be converted from grayscale noise into a Red/Green Flowmap.
    "$emissiveblendflowtexture"  "sprites/T_A_NoiseTurbulence_02"

    // -----------------------------------------------------------
    // 4. ANIMATION / PANNING
    // -----------------------------------------------------------
    // Scrolls the streak texture across the flowmap (UE4: Ribbon_PannX = 0.3)
    "$emissiveblendscrollvector" "[3 0.0]"

	"Proxies"
	{ 
		"Equals" 
		{
			"srcVar1" "$color" 
			"resultVar" "$emissiveblendtint" 
		} 
		"Alpha" 
		{ 
			
		} 
		"Equals" 
		{
			"srcVar1" "$alpha" 
			"resultVar" "$emissiveblendstrength" 
		} 
		"TextureScroll"
        {
            "texturescrollvar"   "$basetexturetransform" // Workaround to scroll the mask/flow
            //"texturescrollrate"  "0.15"
            "texturescrollrate"  "1.5"
            "texturescrollangle" "0.0"
        }
	} 
}
