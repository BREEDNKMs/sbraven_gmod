"VertexLitGeneric"
{
	// Base properties
	"$basetexture" "vgui/black"   // dark base, all glow comes from emissive
	"$selfillum" 1
	"$nocull" 1
	"$additive" 1
	"$translucent" 1

	// Emissive blend setup
	"$emissiveblendenabled" "1" 

	// Flowing emissive texture (RampTex equivalent)
	"$emissiveblendtexture" "sprites/t_a_rampnoise_02"

	// Stationary mask (vertical gradient)
	"$emissiveblendbasetexture" "sprites/t_a_gradient_vertical_06"

	// Flowmap (noise turbulence)
	"$emissiveblendflowtexture" "sprites/t_a_noiseturbulence_04"

	// Tint (HighlightColor ~ white)
	"$emissiveblendtint" "[5 5 5.0]"

	"$emissiveblendscrollvector" "[-1 -1]"
	"$emissiveblendstrength" "1" 

	// Optional detail overlay (to mimic NoiseDust/NoiseRGB)
	"$detail" "sprites/t_a_noisedust_01"
	"$detailscale" 1
	"$detailblendmode" 0   // mod2x or additive could be tested
	"$refvalue" "5" 
	"Proxies" 
	{ 
		"Alpha" // Exposes entity's renderamt to $alpha 
		{
		} 
		"Divide"
		{
		"srcVar1" "$alpha" 
		"srcVar2" "$refvalue" 
		"resultVar" "$emissiveblendstrength" 
		}
		"Equals"
		{ 
		"srcVar1" "$alpha" 
		"resultVar" "$emissiveblendstrength" 
		} 
	} 
}
