"UnlitGeneric"
{
	// Base layer: Flowing liquid streak
	"$basetexture" "sprites/t_a_streakliquid_04"
	"$color" "[10 10 10]" 

	// Detail layer: Gradient / beam mask
	"$detail" "sprites/t_a_gradient_vertical_08"
	"$detailscale" "1"
	"$detailblendfactor" "1"
	"$detailblendmode" "8" // Mode 8 = Multiply (Base * Detail)

	// Mesh & Blending (Fully functional in UnlitGeneric)
	"$additive" "1"
	"$nocull" "1"
	"$model" "1"
	"$vertexcolor" "1"
	"$vertexalpha" "1"

	// Base UV scale
	"$basetexturetransform" "center 0.5 0.5 scale 0.5 1 rotate 0 translate 0 0"
	"$detailtexturetransform" "center 0.5 0.5 scale 1 2 translate 0 0.25"

	"Proxies"
	{
		// Animates the liquid streaks flowing backward along the cut
		"TextureScroll"
		{
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" 3.5
			"texturescrollangle" 0
		}
	}
}